#!/bin/bash
# ----------------------------------------------------------------------------
# nodes/mx-secondary/backup — nightly backup orchestration on the secondary MX
# ----------------------------------------------------------------------------
# Runs on the secondary MX (Ubuntu LTS, OVH-hosted, geographically distinct
# datacentre from web-mail). This node hosts:
#   * the secondary MX (priority 20) for mail continuity
#   * the offsite LUKS backup containers populated by web-mail and nas-home
#
# It owns three responsibilities:
#   1. Mirror the *web-mail* node's rootfs to its own disk (LUKS) and to
#      the home NAS (LAN).
#   2. Pull the vmail spool from web-mail to home NAS, decrypted on-the-fly
#      through a local LUKS volume that was populated earlier by web-mail.
#   3. Cross-replicate the consolidated NAS datasets to web-mail (dual-LUKS
#      pattern: source on a local LUKS, destination on a remote LUKS).
#
# This is where the dual-LUKS section pattern lives — used when the data
# at rest must remain encrypted on both ends, with the crossover happening
# only inside an encrypted SSH tunnel.
#
# License: MIT — see LICENSE in the repository root.
# ----------------------------------------------------------------------------

set -Eeuo pipefail

SCRIPT_NAME="$(basename "$0")"
HOST_FQDN="$(hostname -f 2>/dev/null || hostname)"

ALERT_TO="${ALERT_TO:-admin@example.org}"
ALERT_FROM="${ALERT_FROM:-root@mx-secondary.example.org}"
ALERT_SMTP_SERVER="${ALERT_SMTP_SERVER:-web-mail.example.org}"
ALERT_SMTP_PORT="${ALERT_SMTP_PORT:-465}"
ALERT_SMTP_USER="${ALERT_SMTP_USER:-admin@example.org}"
ALERT_SMTP_PASSWORD_FILE="${ALERT_SMTP_PASSWORD_FILE:-/root/backup-orchestrator/.smtp_pass}"

. /root/backup-orchestrator/luks_functions.sh

CURRENT_LOG_FILE="/var/log/backupMX2_orchestration.log"
LOG_FILE="$CURRENT_LOG_FILE"
CURRENT_JOB_NAME="init"

CURRENT_LOCAL_MAPPER_NAME=""
CURRENT_LOCAL_LUKS_OPEN=0

CURRENT_REMOTE_HOST=""
CURRENT_REMOTE_MAPPER_NAME=""
CURRENT_REMOTE_LUKS_OPEN=0

CTRL_WEB_MAIL_HOST="web-mail"

# ---- rsync exclusions for the mx-secondary rootfs dump ----
# Same idea as on web-mail: never back up our own backups, never copy
# *.crypt files (the LUKS containers themselves are useless without the key).
MX2_ROOT_RSYNC_ARGS=(
  "--delay-updates"
  "--exclude=/dev/*"
  "--exclude=/proc/*"
  "--exclude=/sys/*"
  "--exclude=/home/*.crypt"
  "--exclude=/home/Backup_*/*"
  "--exclude=/home/Downloads/*"
  "--exclude=/home/Installs/*"
  "--exclude=/home/WebApp/*"
  "--exclude=/home/WebMail/*"
  "--exclude=/home/Mail/*"
  "--exclude=/home/Photos/*"
  "--exclude=/home/Pro/*"
  "--exclude=/home/NasHome/*"
  "--exclude=/tmp/*"
  "--exclude=/lost+found"
  "--exclude=/home/tmp_crypt/*"
)

MX2_TO_NAS_RSYNC_ARGS=(
  "${MX2_ROOT_RSYNC_ARGS[@]}"
  "--exclude=*snap/core20/1950/var/lib/vim/snap/core20/1950/var/spool/tmp/*"
)

VMAIL_RSYNC_ARGS=(
  "--delay-updates"
  "--exclude=/dev/*"
  "--exclude=/proc/*"
  "--exclude=/sys/*"
  "--exclude=/home/*"
  "--exclude=/tmp/*"
  "--exclude=/lost+found"
)

# ============================================================================
# Logging primitives
# ============================================================================
set_log_file() {
  CURRENT_LOG_FILE="$1"
  LOG_FILE="$1"
  export LOG_FILE
}

begin_job() {
  local log_file="$1"
  set_log_file "$log_file"
  echo -e "START : $(date)\n" >"$log_file" 2>&1
}

finish_job() {
  local log_file="$1"
  local start_time="$2"
  local end_time
  local time_elapsed

  echo -e "\nFINISH : $(date)\n\n" >>"$log_file"
  end_time="$(date +%s)"
  time_elapsed=$(((end_time-start_time)/60))
  echo "Script execution took $time_elapsed minutes." >>"$log_file" 2>&1
}

# ============================================================================
# rsync wrapper (rc=24 swallowed)
# ============================================================================
run_rsync_checked() {
  local log_file="$1"
  shift
  local rsync_rc=0

  set +e
  rsync "$@" >>"$log_file" 2>&1
  rsync_rc=$?
  set -e

  case "$rsync_rc" in
    0)  return 0 ;;
    24) echo "WARNING: rsync returned rc=24 (some files vanished during transfer)" >>"$log_file"; return 0 ;;
    *)  echo "ERROR: rsync failed with rc=$rsync_rc" >>"$log_file"; return "$rsync_rc" ;;
  esac
}

# ============================================================================
# Local LUKS lifecycle (data-at-rest on this very host)
# ============================================================================
local_prepare_luks() {
  local crypt_file="$1"
  local mapper_name="$2"

  CURRENT_LOCAL_MAPPER_NAME="$mapper_name"
  CURRENT_LOCAL_LUKS_OPEN=1

  prepare_luks_mount \
    "ssh -q -T -o LogLevel=ERROR nas-home 'cat /volume1/NetBackup/.ash'" \
    "$crypt_file" \
    "$mapper_name" \
    "/home/tmp_crypt"
}

local_close_luks() {
  local mapper_name="$1"

  close_luks_mount "$mapper_name" "/home/tmp_crypt"
  assert_no_backup_luks_left_open "/home/tmp_crypt"

  CURRENT_LOCAL_LUKS_OPEN=0
  CURRENT_LOCAL_MAPPER_NAME=""
}

# ============================================================================
# Remote LUKS lifecycle (data-at-rest on the destination host)
# ============================================================================
remote_prepare_luks() {
  local remote_host="$1"
  local crypt_file="$2"
  local mapper_name="$3"

  CURRENT_REMOTE_HOST="$remote_host"
  CURRENT_REMOTE_MAPPER_NAME="$mapper_name"
  CURRENT_REMOTE_LUKS_OPEN=1

  ssh -q -o LogLevel=ERROR "$remote_host" 'bash -s' <<EOF
set -Eeuo pipefail
LOG_FILE="/var/log/${mapper_name}.remote.log"
. /root/backup-orchestrator/luks_functions.sh
prepare_luks_mount "ssh -q -T -o LogLevel=ERROR nas-home 'cat /volume1/NetBackup/.ash'" "$crypt_file" "$mapper_name" "/home/tmp_crypt"
EOF
}

remote_close_luks() {
  local remote_host="$1"
  local mapper_name="$2"

  ssh -q -o LogLevel=ERROR "$remote_host" 'bash -s' <<EOF
set -Eeuo pipefail
LOG_FILE="/var/log/${mapper_name}.remote.log"
. /root/backup-orchestrator/luks_functions.sh
close_luks_mount "$mapper_name" "/home/tmp_crypt"
assert_no_backup_luks_left_open "/home/tmp_crypt"
EOF

  CURRENT_REMOTE_LUKS_OPEN=0
  CURRENT_REMOTE_HOST=""
  CURRENT_REMOTE_MAPPER_NAME=""
}

# ============================================================================
# Job primitives
# ============================================================================

# Plain rsync over SSH — no LUKS at either end. Used for LAN-side links
# where the underlying transport is already trusted (Tailscale).
run_rsync_plain() {
  local job_name="$1"
  local log_file="$2"
  local rsh_cmd="$3"
  local src="$4"
  local dst="$5"
  shift 5
  local -a extra_rsync_args=( "$@" )
  local start_time

  CURRENT_JOB_NAME="$job_name"
  start_time="$(date +%s)"
  begin_job "$log_file"

  run_rsync_checked "$log_file" \
    -ah --partial --stats \
    -e "$rsh_cmd" \
    "${extra_rsync_args[@]}" \
    --delete \
    --stats \
    "$src" "$dst"

  finish_job "$log_file" "$start_time"
}

# rsync with LUKS-encrypted destination (managed remotely from here).
run_rsync_with_remote_luks() {
  local job_name="$1"
  local log_file="$2"
  local rsh_cmd="$3"
  local src="$4"
  local dst="$5"
  local remote_host="$6"
  local remote_crypt_file="$7"
  local remote_mapper_name="$8"
  shift 8
  local -a extra_rsync_args=( "$@" )
  local start_time

  CURRENT_JOB_NAME="$job_name"
  start_time="$(date +%s)"
  begin_job "$log_file"

  echo -e "\nOpening Lock\n" >>"$log_file"
  remote_prepare_luks "$remote_host" "$remote_crypt_file" "$remote_mapper_name" >>"$log_file" 2>&1

  run_rsync_checked "$log_file" \
    -ah --partial --stats \
    -e "$rsh_cmd" \
    "${extra_rsync_args[@]}" \
    --delete \
    --stats \
    "$src" "$dst"

  echo -e "\nLocking Up\n" >>"$log_file"
  remote_close_luks "$remote_host" "$remote_mapper_name" >>"$log_file" 2>&1

  finish_job "$log_file" "$start_time"
}

# rsync with a LOCAL LUKS source (data was previously written here in
# encrypted form by another node, we open it just-in-time to read it).
run_rsync_with_local_luks() {
  local job_name="$1"
  local log_file="$2"
  local rsh_cmd="$3"
  local src="$4"
  local dst="$5"
  local local_crypt_file="$6"
  local local_mapper_name="$7"
  shift 7
  local -a extra_rsync_args=( "$@" )
  local start_time

  CURRENT_JOB_NAME="$job_name"
  start_time="$(date +%s)"
  begin_job "$log_file"

  echo -e "\nOpening Lock\n" >>"$log_file"
  local_prepare_luks "$local_crypt_file" "$local_mapper_name" >>"$log_file" 2>&1

  run_rsync_checked "$log_file" \
    -ah --partial --stats \
    -e "$rsh_cmd" \
    "${extra_rsync_args[@]}" \
    --delete \
    --stats \
    "$src" "$dst"

  echo -e "\nLocking Up\n" >>"$log_file"
  local_close_luks "$local_mapper_name" >>"$log_file" 2>&1

  finish_job "$log_file" "$start_time"
}

# Dual-LUKS section: source on a local LUKS we open, destination on a
# remote LUKS we open. The data is decrypted only in RAM at both ends,
# transits inside the SSH tunnel between them. Used when both copies
# must remain at rest fully encrypted.
dual_luks_section() {
  local title="$1"
  local log_file="$2"
  local rsh_cmd="$3"
  local src="$4"
  local dst="$5"
  local local_crypt_file="$6"
  local local_mapper_name="$7"
  local remote_host="$8"
  local remote_crypt_file="$9"
  local remote_mapper_name="${10}"
  shift 10
  local -a extra_rsync_args=( "$@" )

  echo -e "\r\r============ ${title} ============\r" >>"$log_file" 2>&1

  echo -e "\nOpening Local Lock\n" >>"$log_file" 2>&1
  local_prepare_luks "$local_crypt_file" "$local_mapper_name" >>"$log_file" 2>&1

  echo -e "\nOpening Remote Lock\n" >>"$log_file" 2>&1
  remote_prepare_luks "$remote_host" "$remote_crypt_file" "$remote_mapper_name" >>"$log_file" 2>&1

  run_rsync_checked "$log_file" \
    -ah --partial --stats \
    -e "$rsh_cmd" \
    "${extra_rsync_args[@]}" \
    --delete \
    --stats \
    "$src" "$dst"

  echo -e "\nLocking Up Local\n" >>"$log_file" 2>&1
  local_close_luks "$local_mapper_name" >>"$log_file" 2>&1

  echo -e "\nLocking Up Remote\n" >>"$log_file" 2>&1
  remote_close_luks "$remote_host" "$remote_mapper_name" >>"$log_file" 2>&1
}

plain_section() {
  local title="$1"
  local log_file="$2"
  local rsh_cmd="$3"
  local src="$4"
  local dst="$5"
  shift 5
  local -a extra_rsync_args=( "$@" )

  echo -e "\r\r============ ${title} ============\r" >>"$log_file" 2>&1

  run_rsync_checked "$log_file" \
    -ah --partial --stats \
    -e "$rsh_cmd" \
    "${extra_rsync_args[@]}" \
    --delete \
    --stats \
    "$src" "$dst"
}

# ============================================================================
# Multi-section job: NAS datasets cross-replicated to web-mail
# ============================================================================
run_nas_backups_on_web_mail() {
  local log_file="/var/log/05_backupNasHome_WebMail.log"
  local start_time

  CURRENT_JOB_NAME="NasHome_on_WebMail"
  start_time="$(date +%s)"
  begin_job "$log_file"

  echo -e "\r\r============ START Backup on web-mail ============\r" >>"$log_file" 2>&1

  dual_luks_section \
    "Backup WebApp on web-mail" \
    "$log_file" \
    "ssh -q -o LogLevel=ERROR -p 1622 -T -x" \
    "/home/tmp_crypt/" \
    "root@web-mail.example.org:/home/tmp_crypt/" \
    "/home/Backup_WebApp.crypt" \
    "Backup_WebApp_crypt" \
    "$CTRL_WEB_MAIL_HOST" \
    "/home/Backup_NasHome_WebApp.crypt" \
    "Backup_NasHome_WebApp_crypt" \
    "--delay-updates"

  plain_section \
    "Backup Photos on web-mail" \
    "$log_file" \
    "ssh -q -o LogLevel=ERROR -p 1622 -T -x" \
    "/home/Photos/" \
    "root@web-mail.example.org:/home/Backup_NasHome/Photos/" \
    "--delay-updates"

  dual_luks_section \
    "Backup NasHome on web-mail" \
    "$log_file" \
    "ssh -q -o LogLevel=ERROR -p 1622 -T -x" \
    "/home/tmp_crypt/" \
    "root@web-mail.example.org:/home/tmp_crypt/" \
    "/home/NasHome.crypt" \
    "NasHome_crypt" \
    "$CTRL_WEB_MAIL_HOST" \
    "/home/Backup_NasHome.crypt" \
    "Backup_NasHome_crypt" \
    "--delay-updates"

  echo -e "\r\r============ END Backup on web-mail ============\r" >>"$log_file" 2>&1
  finish_job "$log_file" "$start_time"
}

# ============================================================================
# Error trap
# ============================================================================
error_handler() {
  local line_no="$1"
  local exit_code="$2"
  local failed_cmd="${BASH_COMMAND:-unknown}"
  local body=""

  trap - ERR
  set +e

  if [ "$exit_code" -eq 24 ] && [[ "$failed_cmd" == rsync* ]]; then
    echo "WARNING: rsync returned rc=24 (some files vanished during transfer) - no alert mail sent" >>"$CURRENT_LOG_FILE"
    return 0
  fi

  if [ -n "${CURRENT_LOG_FILE:-}" ]; then
    echo "" >>"$CURRENT_LOG_FILE"
    echo "ERROR at line ${line_no}, exit_code=${exit_code}, command=${failed_cmd}" >>"$CURRENT_LOG_FILE"
  fi

  if [ "${CURRENT_LOCAL_LUKS_OPEN:-0}" -eq 1 ] && [ -n "${CURRENT_LOCAL_MAPPER_NAME:-}" ]; then
    {
      echo ""
      echo "Emergency local cleanup for ${CURRENT_LOCAL_MAPPER_NAME} ..."
    } >>"$CURRENT_LOG_FILE" 2>&1

    local_close_luks "$CURRENT_LOCAL_MAPPER_NAME" >>"$CURRENT_LOG_FILE" 2>&1 || true
    CURRENT_LOCAL_LUKS_OPEN=0
    CURRENT_LOCAL_MAPPER_NAME=""
  fi

  if [ "${CURRENT_REMOTE_LUKS_OPEN:-0}" -eq 1 ] && [ -n "${CURRENT_REMOTE_HOST:-}" ] && [ -n "${CURRENT_REMOTE_MAPPER_NAME:-}" ]; then
    {
      echo ""
      echo "Emergency remote cleanup on ${CURRENT_REMOTE_HOST} for ${CURRENT_REMOTE_MAPPER_NAME} ..."
    } >>"$CURRENT_LOG_FILE" 2>&1

    remote_close_luks "$CURRENT_REMOTE_HOST" "$CURRENT_REMOTE_MAPPER_NAME" >>"$CURRENT_LOG_FILE" 2>&1 || true
    CURRENT_REMOTE_LUKS_OPEN=0
    CURRENT_REMOTE_HOST=""
    CURRENT_REMOTE_MAPPER_NAME=""
  fi

  body="$(
    {
      printf 'Host: %s\n' "$HOST_FQDN"
      printf 'Script: %s\n' "$SCRIPT_NAME"
      printf 'Job: %s\n' "$CURRENT_JOB_NAME"
      printf 'Date: %s\n' "$(date)"
      printf 'Line: %s\n' "$line_no"
      printf 'Exit code: %s\n' "$exit_code"
      printf 'Command: %s\n' "$failed_cmd"
      printf '\nLast log lines:\n\n'
      tail -n 120 "$CURRENT_LOG_FILE" 2>/dev/null || true
    }
  )"

  send_fail_mail "[ALERT] ${SCRIPT_NAME} / ${CURRENT_JOB_NAME} on ${HOST_FQDN}" "$body" || true
  exit "$exit_code"
}

trap 'error_handler "$LINENO" "$?"' ERR

# ============================================================================
# Job declarations
# ============================================================================

# ---- mx-secondary rootfs → web-mail (LUKS) ----
run_rsync_with_remote_luks \
  "MX2_on_WebMail" \
  "/var/log/02_backupMX2_WebMail.log" \
  "ssh -q -o LogLevel=ERROR -p 1622 -T -x" \
  "/" \
  "root@web-mail.example.org:/home/tmp_crypt/" \
  "$CTRL_WEB_MAIL_HOST" \
  "/home/Backup_MX2.crypt" \
  "Backup_MX2_crypt" \
  "${MX2_ROOT_RSYNC_ARGS[@]}"

# ---- mx-secondary rootfs → nas-home (LAN) ----
run_rsync_plain \
  "MX2_on_NasHome" \
  "/var/log/03_backupMX2_NasHome.log" \
  "ssh -q -o LogLevel=ERROR -p 1249 -T -x" \
  "/" \
  "root@nas-home.example.net:/volume1/MX2/" \
  "${MX2_TO_NAS_RSYNC_ARGS[@]}"

# ---- vmail spool → nas-home (decrypt-on-the-fly via local LUKS) ----
run_rsync_with_local_luks \
  "VMAIL_on_NasHome" \
  "/var/log/04_backupMail.log" \
  "ssh -q -o LogLevel=ERROR -p 1249 -T -x" \
  "/home/tmp_crypt/home/vmail/" \
  "root@nas-home.example.net:/volume1/Mail/" \
  "/home/Backup_WebMail.crypt" \
  "Backup_WebMail_crypt" \
  "${VMAIL_RSYNC_ARGS[@]}"

# ---- NAS datasets → web-mail (multi-section dual-LUKS) ----
run_nas_backups_on_web_mail
